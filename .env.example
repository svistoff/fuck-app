# ── Основное ────────────────────────────────────────────────
PORT=8080
BASE_URL=https://example.ru          # без слэша в конце; нужен для magic-ссылок и sitemap
SITE_NAME=Знакомства
CITY_NAME=Москва                     # сайт для одного города — имя подставляется в тексты и SEO

# Секрет для подписи cookie-сессий. Сгенерируй случайную строку:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Почта (magic link) через Resend ─────────────────────────
# Зарегистрируй домен в Resend и пропиши DNS-записи (SPF/DKIM), иначе письма уйдут в спам.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Знакомства <noreply@example.ru>"
# Для локальной отладки без отправки писем поставь 1 — ссылка будет печататься в консоль:
MAIL_DEV_LOG=0

# ── Хранение фото на своём VPS ──────────────────────────────
UPLOAD_DIR=./uploads                 # на проде укажи абсолютный путь, напр. /var/www/example.ru/uploads
MAX_PHOTOS=4                         # 1 основное + 3 дополнительных

# ── Админка (отдельный вход) ────────────────────────────────
ADMIN_USER=admin
# Хеш пароля, а не пароль. Сгенерируй так:
#   node -e "const a=require('./src/auth');console.log(a.hashPassword('твой_пароль'))"
ADMIN_PASS_HASH=
